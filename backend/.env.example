# --- DB ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cooked

# --- LLM providers (free tier, per D-009) ---
# Model ids + task routing priority: edit backend/app/services/llm/models.py
# Optional env overrides (prepend/append to the file chain):
GEMINI_API_KEY=
# GEMINI_MODEL=gemma-4-31b-it
# GEMINI_FALLBACK_MODEL=gemini-2.0-flash
# GEMINI_429_MAX_RETRIES=4
# GROQ_MODEL=llama-3.3-70b-versatile
# Must be from https://console.groq.com/keys — starts with gsk_
# Other vendors (xAI/OpenAI/etc.) will return 401 on api.groq.com.
GROQ_API_KEY=

# --- Object storage (S3-compatible API) ---
# Works with Cloudflare R2, Backblaze B2, MinIO, etc.
# Env names stay R2_* for historical reasons; values are generic S3-compat credentials.

# Cloudflare R2:
# R2_ACCESS_KEY_ID=<R2 token access key>
# R2_SECRET_ACCESS_KEY=<R2 token secret>
# R2_BUCKET=<bucket name>
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_REGION=auto

# Backblaze B2 (S3-compatible API — Bucket Settings → Endpoint):
# R2_ACCESS_KEY_ID=<application key ID>   # often starts with 003…
# R2_SECRET_ACCESS_KEY=<application key>   # long secret from B2 — NOT the key ID
# R2_BUCKET=<bucket name>   # must be all lowercase — mixed case can cause SignatureDoesNotMatch
# R2_ENDPOINT=https://s3.<region>.backblazeb2.com   # must match bucket region
# R2_REGION=<region>   # e.g. eu-central-003 — do NOT use "auto" for B2
# Optional: Backblaze only — omit explicit SSE on PutObject unless you need it (reduces IncompleteBody errors).
# R2_B2_PUT_SSE_AES256=false
# When true, first upload attempt sends x-amz-server-side-encryption: AES256; on IncompleteBody we retry without it.

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
# Cloudflare R2: use "auto". Backblaze B2: use the region from your endpoint (e.g. eu-central-003).
R2_REGION=auto
# Backblaze only: app default is false; set true only if your bucket requires explicit SSE on PutObject.
R2_B2_PUT_SSE_AES256=false

# --- CORS / frontend origin (comma-separated). Must match scheme+host+port in the browser address bar.
# localhost vs 127.0.0.1 differs. Next may use :3002 if :3000 is busy — include both ports.
# If you open via Next "Network:" link, add that URL too (e.g. http://192.168.x.x:3002).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002

# --- Auth / Clerk ---
# Frontend sends `Authorization: Bearer <session JWT>` when signed in — backend verifies against JWKS:
# issuer must match JWT `iss` exactly (typically https://YOUR_APP.clerk.accounts.dev — no trailing slash).
# If CLERK_JWT_ISSUER is empty while CLERK_SECRET_KEY is set: resume reads may still work (optional auth),
# but GET /api/v1/me/roasts and other «require Bearer» routes return 401 until you set the issuer.
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER=

# --- Analytics (added at step 8) ---
POSTHOG_API_KEY=

# --- Prompt versioning (bump when prompts change) ---
PROMPT_VERSION=roast-v3-json-contract

# --- Misc ---
# When true, daily APScheduler job deletes resume raw_text + R2 PDFs older than RAW_TEXT_RETENTION_HOURS (default 24). Omit/false = keep text until re-upload (D-017).
# RAW_TEXT_RETENTION_ENABLED=true
# RAW_TEXT_RETENTION_HOURS=24
# Static interview quiz size (POST /interview/start + /score). Raise to 10–15 for prod.
# INTERVIEW_BATCH_QUESTION_COUNT=3
LOG_LEVEL=INFO
# Optional: log full verbatim model text to stdout (see `app.services.llm.raw_output_log`).
# LLM_LOG_RAW_COMPLETION=true
ENV=local
# DEV=1 — unlimited roasts/quizzes per day; enables POST /api/v1/notes/renew. Omit in production.
# Also emits LLM model-fallback toasts to the frontend (analysis SSE + quiz API).
# DEV=1
# When DEV is not set: 2 roasts/day and 2 quizzes/day (see DAILY_ANALYSIS_CAP / DAILY_QUIZ_CAP).
# DAILY_ANALYSIS_CAP=2
# DAILY_QUIZ_CAP=2
# Legacy: allow notes renew without DEV (also enabled when ENV=local).
# ALLOW_NOTES_RENEW=false
# Optional: include raw LLM text in SSE `failure_debug` when ENV is not local/dev (default off).
# EXPOSE_LLM_DEBUG=false
